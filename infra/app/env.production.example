# /opt/gatekeeper/.env — продовое окружение (chmod 600, владелец deploy).
# Читается docker compose как env_file для обоих контейнеров.
# Комментарии только на отдельных строках: compose может принять хвост
# "  # ..." за часть значения.

APP_NAME=Gatekeeper
# docker run --rm --entrypoint php gatekeeper:current artisan key:generate --show
APP_KEY=
APP_URL=https://gatekeeper.example.com
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

# Caddy: домен админки и вебхука, домен VPN (для проверки Let's Encrypt), почта ACME
APP_DOMAIN=gatekeeper.example.com
VPN_DOMAIN=x.example.com
ACME_EMAIL=admin@example.com

LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# SQLite и путь к базе заданы в образе, сессии админки живут в базе.
# Кеш в файлах storage (общий для app и scheduler): меньше писателей в SQLite
CACHE_STORE=file
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Gatekeeper

ADMIN_EMAIL=
ADMIN_CHAT_ID=
TELEGRAPH_BOT_NOTIFY_ID=1
TELEGRAPH_BOT_USERNAME=
# openssl rand -hex 32
TELEGRAPH_WEBHOOK_SECRET=
TELEGRAPH_PAYMENT_PROVIDER_TOKEN=

# = API_KEY из /etc/strongswan-api.env. Путь к сокету задан в docker-compose.
VPN_SECRET_KEY=

# Сервер вне РФ: Telegram доступен напрямую, прокси не нужен
TELEGRAM_PROXY_ENABLED=false
