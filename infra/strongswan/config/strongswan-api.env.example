# /etc/strongswan-api.env  (chmod 600, владелец root)
# Тот же ключ кладётся в .env Laravel как VPN_SECRET_KEY.
# Сгенерировать: openssl rand -hex 32
API_KEY=

# Где слушать. Unix-сокет снаружи недоступен; контейнер с Laravel монтирует
# каталог /run/strongswan-api. Для ручной отладки можно tcp:127.0.0.1:5000.
LISTEN=unix:/run/strongswan-api/api.sock

# Права сокета: группа 33 — www-data, под ней работает PHP-FPM в контейнере
SOCKET_MODE=0660
SOCKET_GID=33

SECRETS_FILE=/etc/ipsec.secrets
IPSEC_BIN=ipsec
