[Unit]
Description=Gatekeeper StrongSwan user API
After=network.target strongswan-starter.service
Wants=strongswan-starter.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/strongswan-api.env
ExecStart=/usr/bin/python3 /opt/strongswan-api/strongswan_api.py
Restart=always
RestartSec=5

# /run/strongswan-api — каталог сокета, его монтирует контейнер с Laravel
RuntimeDirectory=strongswan-api
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
