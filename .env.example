APP_NAME=Gatekeeper
APP_ENV=local                 # production включает крон и реальные запросы к VPN API
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:18080
APP_TIMEZONE=UTC

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily               # ротация по дням, 14 файлов
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # в проде: warning

# База — локальный файл SQLite (по умолчанию database/database.sqlite)
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/storage/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync         # уведомления уходят сразу, воркер не нужен
CACHE_STORE=database

MAIL_MAILER=log               # без SMTP письма пишутся в лог
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="gatekeeper@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Gatekeeper (config/gatekeeper.php) ---
ADMIN_EMAIL=                  # письма DailySummary / ClientsBlocked / NewDeposit
ADMIN_CHAT_ID=                # telegram_id админа для сводки крона
TELEGRAPH_BOT_NOTIFY_ID=1     # id бота в таблице telegraph_bots
TELEGRAPH_BOT_USERNAME=       # username бота без @, для реферальных ссылок

# --- Telegram-бот (config/telegraph.php) ---
# Токен бота хранится в таблице telegraph_bots: php artisan telegraph:new-bot
TELEGRAPH_WEBHOOK_SECRET=     # Telegram присылает его в заголовке, чужие вебхуки отбрасываются
TELEGRAPH_PAYMENT_PROVIDER_TOKEN=   # ЮKassa, выдаёт @BotFather

# --- VPN API на StrongSwan-сервере (config/vpn.php) ---
VPN_API_HOST=127.0.0.1
VPN_API_PORT=5000
VPN_API_PROTOCOL=http
VPN_API_SOCKET=                # в проде: /run/strongswan-api/api.sock, тогда host/port не нужны
VPN_SECRET_KEY=                # = API_KEY из /etc/strongswan-api.env на VPN-сервере

# --- Исходящий прокси к api.telegram.org (config/telegram.php) ---
# Нужен только если приложение стоит там, где Telegram фильтруется.
TELEGRAM_PROXY_ENABLED=false
TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_FALLBACK_DIRECT=true
TELEGRAM_PROXY_NO_HOSTS=
